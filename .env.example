# Conexão com o banco (PostgreSQL)
# Exemplo local:  postgresql://postgres:postgres@localhost:5432/mentistech
# Exemplo Neon:   postgresql://user:pass@host/db?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://usuario:senha@localhost:5432/mentistech"

# Segredo para assinar tokens JWT (troque por uma string longa e aleatória em produção)
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Expiração do token (em segundos ou string ms, ex: 86400s = 24h)
JWT_EXPIRATION="86400s"

# Chave da API Anthropic (Claude) — obtenha em https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Porta do servidor (opcional, padrão: 3000)
PORT=3000
